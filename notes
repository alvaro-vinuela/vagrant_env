 # virtualbox installation
sudo apt install -y wget apt-transport-https
wget -q https://www.virtualbox.org/download/oracle_vbox_2016.asc -O- | sudo gpg --dearmor -o /usr/share/keyrings/oracle-virtualbox-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/oracle-virtualbox-archive-keyring.gpg] https://download.virtualbox.org/virtualbox/debian $(lsb_release -cs) contrib" | sudo tee /etc/apt/sources.list.d/virtualbox.list
sudo apt update
sudo apt install -y virtualbox-7.0
wget https://download.virtualbox.org/virtualbox/7.0.10/Oracle_VM_VirtualBox_Extension_Pack-7.0.10.vbox-extpack
sudo VBoxManage extpack install Oracle_VM_VirtualBox_Extension_Pack-7.0.10.vbox-extpack

# install vagrant
wget -O- https://apt.releases.hashicorp.com/gpg | gpg --dearmor | sudo tee /usr/share/keyrings/hashicorp-archive-keyring.gpg
echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com $(lsb_release -cs) main" | sudo tee /etc/apt/sources.list.d/hashicorp.list

sudo apt update
sudo apt install vagrant


# configuration - folders /home/vagrant and /home/alvaro/Documentos are copied
- setup-ssh.sh must be on 'Documentos' folder
- sudo password by default on instances is 'vagrant'. Then, use it on cluster deployment

# trick to connect with cmon's root into created vms (by means of vagrant.pub copied)
root@genkidama:~/.ssh# cat /home/alvaro/.ssh/id_ed25519.pub
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICt4UlOnYZ5vPRIWLkgTlLW5Z9a18r55ACYvRvQF8IsW alvaro@genkidama
root@genkidama:~/.ssh# cat /root/.ssh/id_rsa.pub
ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICt4UlOnYZ5vPRIWLkgTlLW5Z9a18r55ACYvRvQF8IsW alvaro@genkidama
# and analog for 'id_rsa'
